<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.ccc.herdr-painter</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/Shared/repos/ccc-herdr/bin/ccc-herdr</string>
		<string>painter</string>
		<string>run</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<!-- fsnotify's kqueue backend opens one fd per file in the watched cache
	     dir (hundreds of session files); launchd's default soft limit (256)
	     would exhaust in silence. -->
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>65536</integer>
	</dict>
	<!-- Same log the [[startup]]-hook path writes, so there is one place to
	     look whichever started the painter. launchd does not expand ~. -->
	<key>StandardOutPath</key>
	<string>/Users/caoer115/.local/share/ucc/cache/ccc-herdr/painter.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/caoer115/.local/share/ucc/cache/ccc-herdr/painter.log</string>
</dict>
</plist>
